# Copie para .env e preencha os valores
# cp .env.example .env

# Administrador inicial (usado na primeira execução se não houver admin no banco)
ADMIN_EMAIL=admin@barbearia.local
ADMIN_SENHA=sua_senha_segura_aqui

# Servidor
PORT=3000
NODE_ENV=development

# Banco de dados (padrão: data/barbearia.db; use :memory: para testes)
DB_FILE=data/barbearia.db

# Cookie seguro (defina 1 apenas em produção com HTTPS)
COOKIE_SECURE=0