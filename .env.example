# ============================================================
# CONFIGURAÇÕES DO SISTEMA NAVALHA BARBEARIA
# Copie este arquivo para .env e preencha os valores reais
# ============================================================

# --- Servidor ---
PORT=3000
NODE_ENV=production

# --- Banco de Dados ---
DB_PATH=./data/barbearia.db

# --- Sessão / Autenticação ---
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=coloque_um_segredo_aleatorio_aqui_64_caracteres

# --- Admin inicial (opcional - senha padrão será gerada se não definido) ---
# ADMIN_EMAIL=admin@barbearia.com
# ADMIN_SENHA=sua_senha_forte_aqui

# ============================================================
# MERCADO PAGO — Gateway de Pagamento (OBRIGATÓRIO para assinaturas)
# ============================================================
# 1. Crie conta em: https://www.mercadopago.com.br/ativacao
# 2. Vá em: Desenvolvedores → Credenciais de produção
# 3. Copie Access Token e Public Key
# 4. Em Webhooks, crie novo apontando para: https://SEU-DOMINIO.com/api/webhook/mercadopago
#    Eventos: payment, subscription_preapproval
# 5. Copie o Webhook Secret gerado

PAGAMENTO_GATEWAY=mercadopago
MP_ACCESS_TOKEN=APP_USR-SEU_ACCESS_TOKEN_AQUI
MP_PUBLIC_KEY=APP_USR-SEU_PUBLIC_KEY_AQUI
MP_WEBHOOK_SECRET=WHS_SEU_WEBHOOK_SECRET_AQUI
MP_SANDBOX=false  # true para testes, false em produção

# ============================================================
# ALTERNATIVA: ASAAS (se preferir usar Asaas em vez do Mercado Pago)
# ============================================================
# PAGAMENTO_GATEWAY=asaas
# ASAAS_API_KEY=SUA_API_KEY_AQUI
# ASAAS_WEBHOOK_SECRET=SEU_WEBHOOK_SECRET_AQUI
# ASAAS_SANDBOX=true

# ============================================================
# STRIPE (alternativa internacional — não recomendado para BR)
# ============================================================
# PAGAMENTO_GATEWAY=stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ============================================================
# CLOUDFLARE TUNNEL (para demo local — opcional)
# ============================================================
# TUNNEL_URL=https://seu-tunnel.trycloudflare.com

# ============================================================
# EXEMPLO DE VALORES PARA TESTE (SANDBOX)
# ============================================================
# MP_SANDBOX=true
# MP_ACCESS_TOKEN=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (token de teste)
# MP_PUBLIC_KEY=APP_USR-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (key de teste)
# MP_WEBHOOK_SECRET=WHS_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX (webhook de teste)